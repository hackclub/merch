#!/bin/sh
# How people used the site: a read-only report from usage_events (AGENTS.md,
# "Usage analytics"). Run it before you change a flow and after you land.
#   scripts/usage-report            production, last 7 days
#   scripts/usage-report 30         production, last 30 days
#   scripts/usage-report --dev 1    the dev DB (agent and test traffic; DATABASE_URL overrides)
#   scripts/usage-report --all 1    keep admins in (errors and slow routes while the site is private)
# Admins (ADMIN_EMAILS) and headless browsers are left out, so it's real people.
# The output is aggregate counts; keep it out of commits anyway.
set -e
dir=$(dirname "$0")
env_file=$("$dir/env-file")
dev=
all=
while :; do
  case $1 in
    --dev) dev=1; shift ;;
    --all) all=1; shift ;;
    *) break ;;
  esac
done
days=${1:-7}
case $days in *[!0-9]* | '') echo "days must be a whole number" >&2; exit 1 ;; esac
admins=$(sed -n 's/^ADMIN_EMAILS=//p' "$env_file" | tail -1 | tr -d "\"' " | tr 'A-Z' 'a-z')
case $admins in *[!a-z0-9@.,_+-]*) echo "ADMIN_EMAILS has unexpected characters" >&2; exit 1 ;; esac

staff="(select id from users where lower(email) = any(string_to_array('$admins', ',')))"
who="real people only"
if [ -n "$all" ]; then staff="(select null::bigint where false)"; who="admins included"; fi
ev="with skip as (
    select distinct visitor from usage_events
    where visitor <> '' and (user_id in $staff or (name = 'visit_start' and props->>'automated' = 'true'))
), ev as (
    select * from usage_events
    where at > now() - interval '$days days' and visitor not in (select visitor from skip)
      and (user_id is null or user_id not in $staff)
)"

sql=$(cat <<SQL
\pset footer off
\echo '== Overview: last $days days, $who'
$ev select count(distinct visitor) visitors, count(distinct nullif(visit, '')) visits,
    count(distinct user_id) signed_in_users,
    count(*) filter (where name = 'page_view') page_views,
    count(*) filter (where name = 'cart') cart_changes,
    count(*) filter (where name = 'shipping_estimate') estimates,
    count(*) filter (where name = 'request_created') requests
from ev;

\echo '== Funnel (visitors): visited -> picked something -> signed in -> sent a request'
$ev select count(distinct visitor) visited,
    count(distinct visitor) filter (where name = 'cart') picked,
    count(distinct visitor) filter (where name = 'sign_in') signed_in,
    count(distinct visitor) filter (where name = 'request_created') requested
from ev;

\echo '== Pages: views, median active seconds, median scroll %'
$ev select regexp_replace(t.path, '^/items/[0-9]+-.*', '/items/*') page, count(*) views,
    round(percentile_cont(.5) within group (order by t.active_ms)::numeric / 1000, 1) median_active_s,
    percentile_cont(.5) within group (order by t.scroll_pct) median_scroll
from usage_page_times t where t.page_view in (select props->>'pv' from ev where name = 'page_view')
group by 1 order by 2 desc limit 15;

\echo '== Items: product page views, hovers, adds, people adding, units requested'
$ev, req as (
    select (l->>'item_id')::bigint item_id, sum((l->>'quantity')::int) units
    from ev, jsonb_array_elements(props->'lines') l where name = 'request_created' group by 1
)
select i.id, i.name,
    count(*) filter (where e.name = 'page_view') views,
    count(*) filter (where e.name = 'item_hover') hovers,
    count(*) filter (where e.name = 'cart' and (e.props->>'to')::int > (e.props->>'from')::int) adds,
    count(distinct e.visitor) filter (where e.name = 'cart' and (e.props->>'to')::int > 0) people_adding,
    coalesce(max(req.units), 0) units_requested
from items i
left join ev e on (e.props->>'item_id')::bigint = i.id
left join req on req.item_id = i.id
where i.visible group by i.id, i.name order by adds desc, views desc limit 40;

\echo '== Shipping estimates by country (fee is what they would pay)'
$ev select props->>'country' country, count(*) estimates,
    count(*) filter (where props ? 'error') refused,
    percentile_cont(.5) within group (order by (props->>'fee_cents')::int) median_fee_cents,
    count(distinct visitor) filter (where name = 'shipping_estimate') people
from ev where name = 'shipping_estimate' group by 1 order by 2 desc limit 20;

\echo '== What went wrong: refused requests and estimates, API and JS errors'
$ev select name, coalesce(props->>'error', props->>'message') error, props->>'api' api, count(*), count(distinct visitor) people
from ev where name in ('request_refused', 'shipping_estimate', 'api_error', 'js_error')
    and (props ? 'error' or props ? 'message')
group by 1, 2, 3 order by 4 desc limit 20;

\echo '== API: slowest and failing routes'
$ev select props->>'route' route, count(*) calls,
    count(*) filter (where (props->>'status')::int >= 500) errors_5xx,
    percentile_cont(.95) within group (order by (props->>'ms')::int) p95_ms
from ev where name = 'api' group by 1 order by p95_ms desc limit 15;

\echo '== Dead clicks (on things that do nothing): where people expected something'
$ev select path, props->>'el' el, props->>'area' area, props->>'item_id' item_id, count(*), count(distinct visitor) people
from ev where name = 'click' and props->>'dead' = 'true' group by 1, 2, 3, 4 order by 5 desc limit 15;

\echo '== Releases (web build time): visitors, picks and requests per build'
$ev select nullif(release, '') release, min(at)::date first_day, count(distinct visitor) visitors,
    count(distinct visitor) filter (where name = 'cart') picked,
    count(distinct visitor) filter (where name = 'request_created') requested,
    count(*) filter (where name = 'shipping_estimate' and props ? 'error') refused_estimates,
    count(*) filter (where name in ('js_error', 'api_error')) errors
from ev group by 1 order by 2 desc nulls last limit 10;

\echo '== Seen vs added: items on screen for a second, and how many of those people added them'
$ev, seen as (
    select distinct t.visitor, jsonb_array_elements_text(t.seen)::bigint item_id from usage_page_times t
    where t.page_view in (select props->>'pv' from ev where name = 'page_view')
), added as (
    select distinct visitor, (props->>'item_id')::bigint item_id from ev where name = 'cart' and (props->>'to')::int > 0
)
select i.name, count(*) people_saw, count(a.visitor) added, round(100.0 * count(a.visitor) / count(*)) pct
from seen s join items i on i.id = s.item_id left join added a using (visitor, item_id)
group by 1 order by 2 desc limit 25;

\echo '== Page speed: Core Web Vitals p75 (LCP/FCP/TTFB/INP ms, CLS) by page'
$ev, v as (select distinct on (visit, props->>'metric') * from ev where name = 'web_vital' order by visit, props->>'metric', at desc)
select props->>'metric' metric, coalesce(nullif(split_part(path, '/', 2), ''), 'home') page,
    count(*) loads, percentile_cont(.75) within group (order by (props->>'value')::float) p75,
    count(*) filter (where props->>'rating' = 'poor') poor
from v group by 1, 2 order by 1, 3 desc;

\echo '== Fields the browser refused at submit'
$ev select props->>'field' field, props->>'reason' reason, path, count(*), count(distinct visitor) people
from ev where name = 'field_invalid' group by 1, 2, 3 order by 4 desc limit 15;

\echo '== Requests (app, last $days days): status, how long they waited to ship, what changed'
select r.status, count(*) requests, count(distinct r.user_id) people,
    round(percentile_cont(.5) within group (order by (d.props->>'wait_h')::float)::numeric, 1) median_wait_h,
    count(*) filter (where (d.props->>'changed')::boolean) shipped_changed,
    sum(r.refunded_cents) refunded_cents
from swag_requests r
left join usage_events d on d.name = 'request_dispatched' and (d.props->>'request_id')::bigint = r.id
where r.source = 'app' and r.created_at > now() - interval '$days days'
    and r.user_id not in $staff
group by 1 order by 2 desc;

\echo '== What admins changed (catalog, limits): line these up with the numbers above'
select at::date as day, name, props->>'item_id' item_id, props->>'sku' sku,
    left(coalesce(props->'changed', props - 'item_id' - 'sku')::text, 160) what
from usage_events where name in ('item_created', 'item_updated', 'item_media_added', 'settings_updated')
    and at > now() - interval '$days days'
order by at desc limit 25;

\echo '== Where visits come from'
$ev select coalesce(nullif(props->>'utm_source', ''), nullif(split_part(props->>'referrer', '/', 3), ''), '(direct)') source,
    count(*) visits, count(*) filter (where (props->>'touch')::boolean) on_touch
from ev where name = 'visit_start' group by 1 order by 2 desc limit 15;
SQL
)

if [ -n "$dev" ]; then
	url=${DATABASE_URL:-$(sed -n 's/^DATABASE_URL=//p' "$env_file" | tail -1)}
	printf '%s\n' "$sql" | PGOPTIONS='-c default_transaction_read_only=on -c statement_timeout=30000' psql "$url" -v ON_ERROR_STOP=1 -q
else
	printf '%s\n' "$sql" | "$dir/prod-psql" -q
fi
